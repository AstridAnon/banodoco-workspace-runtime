{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/task.json",
  "title": "Task and run state",
  "type": "object", "additionalProperties": false,
  "required": ["task_id", "run_id", "project_id", "state", "version", "capability_id", "capability_digest", "idempotency_key", "created_at", "updated_at", "runtime_epoch", "input_object_ids"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
    "project_id": { "type": ["string", "null"], "minLength": 1 },
    "state": { "type": "string", "enum": ["queued", "ready", "running", "succeeded", "failed", "cancel_requested", "cancelled", "retrying"] },
    "version": { "type": "integer", "minimum": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "capability_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "protocol": { "type": "string", "const": "workspace.v1" },
    "schema_version": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "attempt_id": { "type": ["string", "null"] },
    "runtime_epoch": { "type": "integer", "minimum": 1 },
    "input_object_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_facts": { "$ref": "#/definitions/RequiredFacts" },
    "spec": { "type": "object", "additionalProperties": true },
    "generation_intent": { "type": "object", "additionalProperties": true },
    "storage_estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["scratch_bytes", "output_bytes"],
      "properties": {
        "scratch_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
    ,"waiting_reason": { "type": "string" }
    ,"lease_fence": { "type": "integer", "minimum": 1 }
    ,"lease_expires_at": { "type": "string", "format": "date-time" }
    ,"result": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "RequiredFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "exact": { "$ref": "#/definitions/ExactFacts" },
        "minimum": { "$ref": "#/definitions/MinimumFacts" }
      }
    },
    "ExactFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "interpreter": { "type": "string", "minLength": 1 },
        "runtime_lock": { "type": "string", "minLength": 1 },
        "engine_lock": { "type": "string", "minLength": 1 },
        "model_digest": { "type": "string", "minLength": 1 },
        "custom_node_digest": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "port": { "type": ["string", "integer"], "minimum": 0 }
      }
    },
    "MinimumFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vram_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "scratch_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
