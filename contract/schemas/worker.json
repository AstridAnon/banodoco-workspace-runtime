{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/worker.json",
  "title": "Executor registration and fenced settlement",
  "type": "object", "additionalProperties": false,
  "definitions": {
    "Capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "definition_digest", "status", "required_resource_keys", "estimated_scratch_bytes", "estimated_output_bytes"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["ready", "unavailable", "unsupported", "retired"] },
        "unavailable_reason": { "type": ["string", "null"] },
        "required_resource_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "estimated_scratch_bytes": { "type": "integer", "minimum": 0 },
        "estimated_output_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "Executor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "max_concurrency", "resource_keys", "capabilities", "protocol"],
      "properties": {
        "executor_id": { "type": "string", "minLength": 1 },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "resource_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "$ref": "#/definitions/Capability" } },
        "protocol": { "type": "string", "const": "workspace.v1" },
        "source_digest": { "type": ["string", "null"], "minLength": 1 },
        "dependency_digest": { "type": ["string", "null"], "minLength": 1 },
        "source_epoch": { "type": ["string", "null"], "minLength": 1 },
        "schema_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "verified_facts": { "$ref": "#/definitions/VerifiedFacts" },
        "runtime_epoch": { "type": ["integer", "null"], "minimum": 1 },
        "readiness": { "type": "string", "enum": ["ready", "not_ready"] },
        "readiness_reason": { "type": ["string", "null"] }
      }
    },
    "VerifiedFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "exact": { "$ref": "#/definitions/ExactFacts" },
        "minimum": { "$ref": "#/definitions/MinimumFacts" }
      }
    },
    "ExactFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "interpreter": { "type": "string", "minLength": 1 },
        "runtime_lock": { "type": "string", "minLength": 1 },
        "engine_lock": { "type": "string", "minLength": 1 },
        "model_digest": { "type": "string", "minLength": 1 },
        "custom_node_digest": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "port": { "type": ["string", "integer"], "minimum": 0 }
      }
    },
    "MinimumFacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vram_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "scratch_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "AttemptFence": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "task_id", "project_id", "lease_id", "fence", "lease_expires_at", "runtime_epoch", "input_object_ids"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": ["string", "null"], "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "fence": { "type": "integer", "minimum": 1 },
        "lease_expires_at": { "type": "string", "format": "date-time" },
        "runtime_epoch": { "type": "integer", "minimum": 1 },
        "input_object_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "spec": { "type": "object", "additionalProperties": true },
        "generation_intent": { "type": "object", "additionalProperties": true },
        "expected_effect": { "$ref": "#/definitions/Effect" },
        "required_facts": { "$ref": "#/definitions/VerifiedFacts" },
        "storage_estimate": {
          "type": "object", "additionalProperties": false,
          "required": ["scratch_bytes", "output_bytes"],
          "properties": {
            "scratch_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "output_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "ClaimWaiting": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "waiting_reason"],
      "properties": {
        "task": { "$ref": "./task.json" },
        "waiting_reason": { "type": "string", "enum": ["waiting_for_worker", "capability_unavailable", "insufficient_storage", "waiting_for_gpu", "waiting_for_cpu", "waiting_for_network", "waiting_for_executor_facts", "waiting_for_dependencies", "dependency_failed", "dependency_cancelled"] }
      }
    },
    "Settlement": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id", "fence", "runtime_epoch", "outputs", "effect"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "fence": { "type": "integer", "minimum": 1 },
        "runtime_epoch": { "type": "integer", "minimum": 1 },
        "result": {
          "type": "object",
          "additionalProperties": true,
          "not": { "required": ["outputs"] }
        },
        "outputs": { "type": "array", "items": { "$ref": "#/definitions/Output" } },
        "effect": { "anyOf": [{ "$ref": "#/definitions/Effect" }, { "type": "null" }] }
      }
    },
    "Output": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "digest", "media_type", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["object", "document", "value"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "data_base64": { "type": "string" },
        "filename": { "type": "string", "minLength": 1, "maxLength": 512 },
        "output_port": { "type": "string", "minLength": 1, "maxLength": 255 },
        "selector": { "type": "object", "additionalProperties": false, "required": ["group_key", "variant_key"], "properties": { "group_key": { "type": "string", "minLength": 1 }, "variant_key": { "type": "string" } } },
        "group_key": { "type": "string", "minLength": 1 },
        "variant_key": { "type": "string" },
        "generation_id": { "type": ["string", "null"] },
        "ordinal": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "minLength": 1, "maxLength": 255 },
        "is_primary": { "type": "boolean" },
        "durability": { "type": "string", "enum": ["durable", "temporary"] },
        "producer": { "type": "object" },
        "provenance": { "type": "object" },
        "regeneration": { "$ref": "./managed-output.json#/properties/regeneration" },
        "coverage": { "$ref": "./managed-output.json#/properties/coverage" },
         "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Effect": {
      "anyOf": [
        { "$ref": "#/definitions/ProjectUpdateEffect" },
        { "$ref": "#/definitions/GenerationVariantAppendEffect" },
        { "$ref": "#/definitions/GenerationCreateWithVariantEffect" },
        { "$ref": "#/definitions/GenerationPublishV1Effect" }
      ]
    },
    "ProjectUpdateEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_type", "target_id", "expected_version", "payload"],
      "properties": {
        "effect_type": { "type": "string", "const": "project.update" },
        "target_id": { "type": "string", "minLength": 1 },
        "expected_version": { "type": "integer", "minimum": 1 },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "GenerationVariantAppendEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_type", "target_id", "expected_version", "payload"],
      "properties": {
        "effect_type": { "type": "string", "const": "generation.variant.append" },
        "target_id": { "type": "string", "minLength": 1, "description": "Target generation id." },
        "expected_version": { "type": "integer", "minimum": 1, "description": "Expected target generation version." },
        "payload": { "$ref": "#/definitions/GenerationVariantAppendPayload" }
      }
    },
    "GenerationVariantAppendPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["source_variant_id", "source_object_id", "variant_type", "output_name", "output_ordinal", "primary_policy"],
      "properties": {
        "source_variant_id": { "type": "string", "minLength": 1 },
        "source_object_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "variant_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "output_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "output_ordinal": { "type": "integer", "const": 0 },
        "primary_policy": { "type": "string", "const": "preserve" }
      }
    },
    "GenerationCreateWithVariantEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_type", "target_id", "payload"],
      "properties": {
        "effect_type": { "type": "string", "const": "generation.create_with_variant" },
        "target_id": { "type": "string", "minLength": 1, "description": "Target project id." },
        "payload": { "$ref": "#/definitions/GenerationCreateWithVariantPayload" }
      }
    },
    "GenerationCreateWithVariantPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_type", "metadata", "variant_type", "output_name", "output_ordinal", "primary_policy"],
      "properties": {
        "generation_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "metadata": { "type": "object", "additionalProperties": true },
        "variant_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "output_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "output_ordinal": { "type": "integer", "const": 0 },
        "primary_policy": { "type": "string", "const": "preserve" }
      }
    },
    "GenerationPublishV1Effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_type", "target_id", "payload"],
      "properties": {
        "effect_type": { "type": "string", "const": "generation.publish_v1" },
        "target_id": { "type": "string", "minLength": 1, "description": "The admitted task project id." },
        "payload": { "$ref": "#/definitions/GenerationPublishV1Payload" }
      }
    },
    "GenerationPublishV1Payload": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "modality", "generation_type", "metadata", "partial_success_policy", "groups"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "modality": { "type": "string", "enum": ["image", "video", "audio"] },
        "generation_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "metadata": { "type": "object", "additionalProperties": true },
        "partial_success_policy": { "type": "string", "enum": ["reject", "allow"] },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/GenerationPublishV1Group" } }
      }
    },
    "GenerationPublishV1Group": {
      "type": "object", "additionalProperties": false,
      "required": ["group_key", "selectors"],
      "properties": {
        "group_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/GenerationPublishV1Selector" } }
      }
    },
    "GenerationPublishV1Selector": {
      "type": "object", "additionalProperties": false,
      "required": ["selector", "ordinal", "variant_key", "output_port"],
      "properties": {
        "selector": { "type": "string", "minLength": 1, "maxLength": 255 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "variant_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "output_port": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    }
  }
}
